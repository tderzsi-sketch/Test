# ── Alpaca API credentials ────────────────────────────────────────────────────
# Sign up for a free account at https://app.alpaca.markets
# Go to "Paper Trading" → "API Keys" → generate a key pair

ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Paper trading URL (safe for testing — no real money)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Set to "false" ONLY when you are ready for live trading with real money
PAPER_TRADING=true

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
